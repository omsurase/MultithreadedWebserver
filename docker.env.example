# Proxy Server Configuration
# Copy this file to .env and modify the values as needed

# Server Type: Threadpool or Semaphore
SERVER_TYPE=Threadpool

# Cache Type: LRUCache or LFUCache
CACHE_TYPE=LRUCache

# Port to run the proxy server on
PROXY_PORT=8080

# Number of threads (for Threadpool) or semaphore count (for Semaphore)
THREAD_COUNT=25

# Cache size (number of cached items)
CACHE_SIZE=100

# Container name (optional, defaults to proxy-server)
CONTAINER_NAME=proxy-server

# Example configurations:
# For high performance:
# SERVER_TYPE=Threadpool
# CACHE_TYPE=LRUCache
# PROXY_PORT=8080
# THREAD_COUNT=50
# CACHE_SIZE=500

# For semaphore-based server:
# SERVER_TYPE=Semaphore
# CACHE_TYPE=LFUCache
# PROXY_PORT=8082
# THREAD_COUNT=30
# CACHE_SIZE=150